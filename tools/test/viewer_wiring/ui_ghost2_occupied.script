# UI-GHOST-2 ADAPTATION (--occupied-outline on): outlines the blocking building footprint(s)
# (0xff4040) alongside the cursor's yellow refusal rectangle (0xffff00) on Reject::Occupied, and
# draws none when hidden or refused for non-Occupied reasons.
resize 1024 768
look 1284 540
wait frames 5
key b
wait frames 5
click_px 833 330
wait frames 5
expect title build 501

# Occupied over 4x4 Kontor (1284, 540): both cursor yellow box and blocking footprint outline appear.
hover-land 1283 540
wait fact tool.ghost == refused
expect fact tool.ghost.verdict == Occupied
wait frames 3
expect fact tool.ghost.pixels > 0
expect fact tool.ghost.occupied_pixels > 0
expect fact tool.ghost.suppressed == 0
screenshot occupied_on_kontor

# Pointer on panel chrome hides both outlines.
hover_px 950 600
wait fact tool.ghost == hidden
wait frames 3
expect fact tool.ghost.pixels == 0
expect fact tool.ghost.occupied_pixels == 0
screenshot occupied_on_hidden

# Non-Occupied refusal (inlet TerrainRefused) draws yellow refusal rectangle only, 0 red pixels.
look 1148 536
wait frames 3
hover-land 1148 536
wait fact tool.ghost.verdict == TerrainRefused
expect fact tool.ghost == refused
wait frames 3
expect fact tool.ghost.pixels > 0
expect fact tool.ghost.occupied_pixels == 0
screenshot occupied_on_terrain_refused
quit
