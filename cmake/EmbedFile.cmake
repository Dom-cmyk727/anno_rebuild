# anno_embed_text(<out.cpp> <symbol> <file>): writes a C++ source that
# defines `extern const unsigned char <symbol>[]` (NUL-terminated) and
# `extern const std::size_t <symbol>_size` with the file's bytes, as a byte
# array: MSVC limits string literals to 16 KiB, the shaders are larger.
# Re-run at build time when the file changes (CMAKE_CONFIGURE_DEPENDS).
function(anno_embed_text out symbol file)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
  file(READ ${file} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],){16}" "\\0\n" hex "${hex}")
  file(WRITE ${out}
    "// Generated by cmake/EmbedFile.cmake from ${file}; do not edit.\n"
    "#include <cstddef>\n"
    "extern const unsigned char ${symbol}[];\n"
    "extern const std::size_t ${symbol}_size;\n"
    "const unsigned char ${symbol}[] = {\n${hex}0x00};\n"
    "const std::size_t ${symbol}_size = ${bytes};\n")
endfunction()
