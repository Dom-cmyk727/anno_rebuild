if(NOT WRAPPER OR NOT TEST_ROOT)
  message(FATAL_ERROR "pass WRAPPER and TEST_ROOT")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef unique)
set(root "${TEST_ROOT}/expansion-replay-contract-${unique}")
file(MAKE_DIRECTORY "${root}")
set(marker "${root}/executed.txt")
file(WRITE "${root}/child.cmake" "file(WRITE \"${marker}\" \"executed\")\nmessage(STATUS \"legal replay\")\n")
function(probe game expected_rc expected_output)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ANNO1503_GAME_DIR=${game}"
                  "${CMAKE_COMMAND}" "-DPROG=${CMAKE_COMMAND}"
                  "-DARGS=-P|${root}/child.cmake" "-DEXPECT_RC=${expected_rc}"
                  "-DEXPECT=${expected_output}" -P "${WRAPPER}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(result "${rc}" PARENT_SCOPE)
  set(output "${out}${err}" PARENT_SCOPE)
endfunction()
probe("" 0 "legal replay")
if(NOT result STREQUAL "0" OR NOT output MATCHES "skipping: ANNO1503_GAME_DIR not set" OR EXISTS "${marker}")
  message(FATAL_ERROR "asset absence did not skip without executing: ${result} ${output}")
endif()
probe("declared-fixture" 0 "legal replay")
if(NOT result STREQUAL "0" OR NOT EXISTS "${marker}")
  message(FATAL_ERROR "legal child did not execute successfully: ${result} ${output}")
endif()
probe("declared-fixture" 0 "wrong output")
if(result STREQUAL "0" OR NOT output MATCHES "does not match")
  message(FATAL_ERROR "wrong output escaped validation: ${result} ${output}")
endif()
probe("declared-fixture" 1 "legal replay")
if(result STREQUAL "0" OR NOT output MATCHES "exit status")
  message(FATAL_ERROR "wrong expected exit escaped validation: ${result} ${output}")
endif()
file(REMOVE_RECURSE "${root}")
message(STATUS "expansion replay asset and execution controls passed")
